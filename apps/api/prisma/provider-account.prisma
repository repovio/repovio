model ProviderAccount {
  id        String   @id @default(uuid()) @db.Uuid
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  providerType           ProviderType
  displayName            String   @db.VarChar(255)
  baseUrl                String?  @db.VarChar(2048)
  encryptedAccessToken   String   @db.Text
  authenticationMethod   String   @default("TOKEN") @db.VarChar(32)
  githubInstallationId   String?  @unique @db.VarChar(32)
  githubInstallationState String? @db.VarChar(32)
  encryptedRefreshToken  String? @db.Text
  oauthAccessTokenExpiresAt DateTime?
  oauthClientId          String? @db.Text
  oauthRedirectUri       String? @db.Text
  gitlabUserId           String? @db.VarChar(32)
  oauthStatus            String @default("NONE") @db.VarChar(32)
  oauthAuthorizationRevision Int @default(0)
  enabled                Boolean  @default(true)
  lastSyncAt             DateTime?
  lastSyncError          String?  @db.Text
  syncLeaseToken         String?  @db.VarChar(64)
  syncLeaseExpiresAt     DateTime?
  rateLimitResetAt       DateTime?
  repositories           Repository[]
  actors                 ProviderActor[]
  organizationWebhooks   OrganizationWebhook[]

  @@unique([providerType, displayName])
  @@map("provider_accounts")
}
