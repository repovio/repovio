meta {
  name: check subscription status
  type: http
  seq: 1
}

post {
  url: {{host}}/api/v1/browser-push/subscriptions/status
  body: json
  auth: inherit
}

body:json {
  { "endpoint": "{{browserPushEndpoint}}" }
}

docs {
  Set browserPushEndpoint as a secret environment variable. Unknown and foreign endpoints both return enrolled=false.
}
