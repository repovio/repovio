{
  "name": "@repovio/website",
  "private": true,
  "type": "module",
  "description": "Multilingual Repovio website and versioned documentation.",
  "homepage": "https://repovio.de",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/repovio/repovio.git",
    "directory": "apps/website"
  },
  "scripts": {
    "dev": "node scripts/check-release-notes.mjs && nuxt dev --host 127.0.0.1 --port 3002",
    "build": "node scripts/check-release-notes.mjs && nuxt build",
    "start": "node .output/server/index.mjs",
    "postinstall": "nuxt prepare",
    "typecheck": "nuxt typecheck",
    "lint": "eslint .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:api-reference": "node scripts/check-api-reference.mjs",
    "docs:check": "node scripts/check-docs.mjs",
    "capture": "node scripts/capture-ui.mjs",
    "test:container": "node scripts/check-container.mjs",
    "docs:test": "node --test content/tests/*.test.mjs",
    "docker:build": "docker build -f apps/website/Dockerfile -t repovio-website:local ../..",
    "docs:promote": "node scripts/promote-monorepo-docs.mjs"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.0",
    "@nuxt/content": "3.16.2",
    "@nuxt/ui": "4.12.0",
    "@nuxtjs/i18n": "10.6.0",
    "nuxt": "4.6.3",
    "shiki": "^4.6.0",
    "tailwindcss": "^4.1.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.15.0",
    "@playwright/test": "^1.58.0",
    "@types/node": "^26.6.6",
    "eslint": "^10.14.0",
    "prettier": "^3.9.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "vue-tsc": "^3.1.0",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "version": "0.2.3",
  "engines": {
    "node": ">=26.13.0 <27"
  }
}
