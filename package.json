{
  "name": "repovio",
  "version": "2.1.0",
  "private": true,
  "description": "Read-only workflow status dashboard for GitHub, GitLab, Forgejo, and Gitea.",
  "license": "MIT",
  "packageManager": "pnpm@11.28.9",
  "engines": {
    "node": ">=26.13.0 <27",
    "pnpm": "11.28.9"
  },
  "scripts": {
    "build": "nx run-many -t build --all --exclude=repovio --parallel=2",
    "changeset": "changeset",
    "db:generate": "nx run api:db:generate",
    "dev": "nx run-many -t dev --all --exclude=repovio --parallel=3",
    "docker:build": "nx run-many -t docker:build --all --exclude=repovio --parallel=2",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs",
    "lint": "pnpm test:guidelines && pnpm documentation:check && eslint scripts libs apps/api apps/web ./*.mjs && nx run-many -t lint --all --exclude=repovio --parallel=2",
    "nx": "nx",
    "release": "changeset tag",
    "test:postgres-upgrade": "node --test scripts/check-postgres-upgrade.test.mjs",
    "test:dependencies": "node --test scripts/check-dependency-security.test.mjs",
    "test": "nx run-many -t test --all --exclude=repovio --parallel=2",
    "typecheck": "nx run-many -t typecheck --all --exclude=repovio --parallel=2",
    "version-packages": "changeset version",
    "branding:check": "node scripts/check-branding.mjs",
    "documentation:check": "node scripts/check-documentation.mjs",
    "test:guidelines": "node --test scripts/check-documentation.test.mjs scripts/format.test.mjs scripts/check-api-tsdoc.test.mjs",
    "test:ci": "node --test scripts/ci-areas.test.mjs scripts/released-packages.test.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-vue": "^10.12.0",
    "nx": "^24.0.3",
    "prettier": "^3.9.10",
    "prettier-plugin-organize-imports": "^4.3.0",
    "tsx": "^4.23.15",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.72.1",
    "@typescript/native": "npm:typescript@^7.0.2"
  }
}
