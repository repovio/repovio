# Local PostgreSQL bootstrap values. Replace all example credentials and keys
# before any shared or production deployment.
POSTGRES_DB=repovio
POSTGRES_USER=repovio
POSTGRES_PASSWORD=replace-with-a-unique-postgresql-password

# API runtime configuration.
NODE_ENV=development
PORT=3001
DATABASE_URL=postgresql://repovio:replace-with-a-unique-postgresql-password@localhost:5432/repovio?schema=public
SHADOW_DATABASE_URL=postgresql://repovio:replace-with-a-unique-postgresql-password@localhost:5432/repovio_shadow?schema=public
CORS_ORIGIN=http://localhost:3000
PUBLIC_URL=http://localhost:3000

# Authentication and encrypted provider credentials. Generate a unique,
# Base64-encoded 32-byte encryption key for every deployment.
AUTH_JWT_ISSUER=repovio
AUTH_JWT_SECRET=replace-with-a-unique-random-jwt-secret
AUTH_JWT_EXPIRATION=7d
TOKEN_ENCRYPTION_KEY=replace-with-a-base64-encoded-32-byte-key

# Exact public API callback URL for optional OpenID Connect sign-in. Provider
# details and credentials are configured by a system administrator in Repovio.
OIDC_CALLBACK_URL=http://localhost:3001/api/v1/auth/oidc/callback

# Optional browser push. Generate a VAPID key pair and configure all three
# values to enable native browser notification channels.
WEB_PUSH_VAPID_PUBLIC_KEY=
WEB_PUSH_VAPID_PRIVATE_KEY=
WEB_PUSH_VAPID_SUBJECT=

# OAuth application registrations for provider accounts. Register the exact
# callback URL with every enabled provider. Keep client secrets out of Git.
OAUTH_CALLBACK_URL=http://localhost:3001/api/v1/provider-accounts/oauth/callback
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITLAB_OAUTH_BASE_URL=https://gitlab.com
GITLAB_OAUTH_CLIENT_ID=
GITLAB_OAUTH_CLIENT_SECRET=
FORGEJO_OAUTH_BASE_URL=
FORGEJO_OAUTH_CLIENT_ID=
FORGEJO_OAUTH_CLIENT_SECRET=

# Background jobs. Set SCHEDULER_ENABLED=false for tests and one-off commands.
SCHEDULER_ENABLED=true
SCHEDULER_SYNC_INTERVAL_SECONDS=1800


# Docker Compose uses this to select matching API and web image versions.
REPOVIO_VERSION=latest

# For upgrades, set the exact existing PostgreSQL Docker volume name before starting.
REPOVIO_POSTGRES_VOLUME=repovio-postgres
