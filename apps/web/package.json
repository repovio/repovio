{
  "name": "@repovio/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @repovio/schemas build && nuxt build",
    "dev": "pnpm --filter @repovio/schemas build && nuxt dev --port 3000",
    "docker:build": "docker build -f Dockerfile -t repovio-web:local ../..",
    "e2e": "playwright test",
    "e2e:pwa": "pnpm build && playwright test --config playwright.pwa.config.ts",
    "e2e:providers": "playwright test tests/e2e/providers.spec.ts",
    "generate:pwa-assets": "pwa-assets-generator",
    "lint": "eslint app nuxt.config.ts --max-warnings=0",
    "test": "pnpm --filter @repovio/schemas build && nuxt prepare && vitest run",
    "typecheck": "pnpm --filter @repovio/schemas build && nuxt typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vite-pwa/assets-generator": "1.0.4",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.1.0",
    "vue-tsc": "3.3.14",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.155",
    "@iconify-json/simple-icons": "^1.2.102",
    "@iconify-json/tabler": "^1.2.46",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@querry-kit/nuxt": "^0.2.10",
    "@querry-kit/nuxt-ui": "^3.3.10",
    "@tanstack/table-core": "^9.3.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "axios": "1.21.1",
    "cropperjs": "^2.3.1",
    "dompurify": "^3.4.18",
    "marked": "^18.2.0",
    "nuxt": "^4.6.4",
    "pinia": "^4.1.0",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.45",
    "vue-i18n": "11.4.20",
    "vue-router": "^5.5.1",
    "zod": "^4.6.7",
    "@repovio/schemas": "workspace:*"
  }
}
