meta {
  name: create organization webhook
  type: http
  seq: 2
}

post {
  url: {{host}}/api/v1/provider-accounts/{{providerAccountId}}/organization-webhooks
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "scope": "acme",
    "webhookSecret": "{{webhookSecret}}"
  }
}

docs {
  Optional: include the UUID returned by the draft endpoint as `id` to preserve a previewed callback URL.
  Without `id`, creation retains server-generated identity. `webhookSecret` must remain a secret variable.
}
