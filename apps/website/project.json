{
  "name": "website",
  "projectType": "application",
  "root": "apps/website",
  "sourceRoot": "apps/website/app",
  "targets": {
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm build",
        "cwd": "apps/website"
      },
      "outputs": ["{projectRoot}/.output"],
      "inputs": ["production", "^production", "{workspaceRoot}/CHANGELOG.md"]
    },
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm dev",
        "cwd": "apps/website"
      }
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm lint",
        "cwd": "apps/website"
      }
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm test",
        "cwd": "apps/website"
      },
      "inputs": ["default", "^default", "{workspaceRoot}/CHANGELOG.md"]
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm typecheck",
        "cwd": "apps/website"
      },
      "inputs": ["default", "^default", "{workspaceRoot}/CHANGELOG.md"]
    },
    "docker:build": {
      "executor": "nx:run-commands",
      "options": {
        "command": "pnpm docker:build",
        "cwd": "apps/website"
      },
      "inputs": ["production", "^production", "{workspaceRoot}/CHANGELOG.md"]
    }
  }
}
