{
  "name": "@ezrepo/web",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev --port 3000",
    "docker:build": "docker build -f Dockerfile -t ezrepo-web:local ../..",
    "e2e": "playwright test",
    "e2e:pwa": "pnpm build && playwright test --config playwright.pwa.config.ts",
    "e2e:providers": "playwright test tests/e2e/providers.spec.ts",
    "generate:pwa-assets": "pwa-assets-generator",
    "lint": "eslint app nuxt.config.ts --max-warnings=0",
    "test": "nuxt prepare && vitest run",
    "typecheck": "nuxt typecheck"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@vite-pwa/assets-generator": "^2.0.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vitest": "^5.0.5",
    "vue-tsc": "3.3.13",
    "@typescript/native": "npm:typescript@^7.0.2"
  },
  "dependencies": {
    "@iconify-json/lucide": "^1.2.150",
    "@iconify-json/simple-icons": "^1.2.101",
    "@iconify-json/tabler": "^1.2.43",
    "@nuxt/fonts": "^1.2.0",
    "@nuxt/icon": "^2.6.2",
    "@nuxt/ui": "^4.12.0",
    "@nuxtjs/color-mode": "^4.1.0",
    "@nuxtjs/i18n": "^10.6.0",
    "@pinia/nuxt": "^1.0.3",
    "@querry-kit/nuxt": "^0.2.9",
    "@querry-kit/nuxt-ui": "^3.3.9",
    "@tanstack/table-core": "^9.3.1",
    "@vite-pwa/nuxt": "^1.1.1",
    "@vueuse/core": "^15.0.0",
    "@vueuse/router": "^15.0.0",
    "axios": "1.21.0",
    "cropperjs": "^2.3.1",
    "dompurify": "^3.4.17",
    "marked": "^18.1.2",
    "nuxt": "^4.6.3",
    "pinia": "^4.1.0",
    "socket.io-client": "^4.8.4",
    "vue": "^3.5.44",
    "vue-i18n": "11.4.17",
    "vue-router": "^5.4.0",
    "zod": "^4.6.7"
  }
}
