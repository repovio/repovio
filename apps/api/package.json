{
  "name": "@repovio/api",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "build": "pnpm --filter @repovio/schemas build && nest build",
    "db:generate": "prisma generate --config prisma.config.ts",
    "db:migrate:deploy": "prisma migrate deploy --config prisma.config.ts",
    "db:migrate:dev": "prisma migrate dev --config prisma.config.ts",
    "db:validate": "prisma validate --config prisma.config.ts",
    "db:reset-password": "node dist/scripts/reset-password.js",
    "dev": "pnpm --filter @repovio/schemas build && nest start --watch",
    "docker:build": "docker build -f Dockerfile -t repovio-api:local ../..",
    "test:openapi": "pnpm build && node --test ../../scripts/check-openapi-export.test.mjs",
    "openapi:export": "pnpm build && node dist/scripts/export-openapi.js",
    "lint": "eslint . && node --test ../../scripts/check-api-tsdoc.test.mjs && node ../../scripts/check-api-tsdoc.mjs",
    "start": "nest start",
    "start:prod": "node dist/main.js",
    "test": "pnpm --filter @repovio/schemas build && NODE_ENV=test node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.ts --runInBand",
    "typecheck": "pnpm --filter @repovio/schemas build && tsc --noEmit --project tsconfig.json"
  },
  "devDependencies": {
    "@nestjs/cli": "^12.0.11",
    "@nestjs/schematics": "^12.0.12",
    "@nestjs/testing": "^12.3.2",
    "@types/bcrypt": "^6.0.0",
    "@types/jest": "^30.0.0",
    "@types/node": "^26.6.6",
    "@types/passport-jwt": "^4.0.1",
    "@types/passport-local": "^1.0.38",
    "@types/pg": "^8.23.1",
    "@types/picomatch": "^4.0.3",
    "@types/web-push": "^3.6.4",
    "jest": "^30.5.2",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@jest/globals": "^30.5.2"
  },
  "dependencies": {
    "@casl/ability": "^7.1.1",
    "@casl/prisma": "^2.2.0",
    "@modelcontextprotocol/node": "^2.1.2",
    "@modelcontextprotocol/server": "^2.4.0",
    "@nestjs/common": "^12.3.2",
    "@nestjs/core": "^12.3.2",
    "@nestjs/jwt": "^12.0.3",
    "@nestjs/passport": "^12.0.0",
    "@nestjs/platform-socket.io": "^12.3.2",
    "@nestjs/schedule": "^12.0.2",
    "@nestjs/swagger": "^12.1.0",
    "@nestjs/throttler": "^6.7.1",
    "@nestjs/websockets": "^12.3.3",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@querry-kit/nest": "^1.1.2",
    "@scalar/nestjs-api-reference": "^1.2.34",
    "bcrypt": "^6.0.0",
    "dotenv": "^18.0.9",
    "envalid": "^9.0.0",
    "openid-client": "6.8.9",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "passport-local": "^1.0.0",
    "pg": "^8.23.1",
    "picomatch": "^4.0.7",
    "prisma": "^7.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "sharp": "^0.35.5",
    "socket.io": "^4.8.4",
    "web-push": "^3.6.7",
    "zod": "^4.6.7",
    "@repovio/schemas": "workspace:*",
    "@nestjs/platform-fastify": "^12.3.2",
    "@fastify/cookie": "^11.0.2",
    "nestjs-zod": "^5.0.1",
    "fastify": "^5.12.8",
    "@fastify/multipart": "^9.3.0"
  },
  "type": "module"
}
