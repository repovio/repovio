meta {
  name: rotate organization webhook secret
  type: http
  seq: 3
}

patch {
  url: {{host}}/api/v1/provider-accounts/{{providerAccountId}}/organization-webhooks/{{organizationWebhookId}}
  body: json
  auth: bearer
}

auth:bearer {
  token: {{token}}
}

body:json {
  {
    "webhookSecret": "{{webhookSecret}}"
  }
}
