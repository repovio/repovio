{
  "openapi": "3.0.3",
  "info": { "title": "Repovio API fixture", "version": "2.0" },
  "security": [{ "bearer": [] }],
  "paths": {
    "/api/v1/items/{id}": {
      "parameters": [{ "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }],
      "get": {
        "tags": ["Items"],
        "summary": "Read an item",
        "description": "A synthetic item with nested and recursive fields.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "description": "Item identifier",
            "schema": { "type": "string", "format": "uuid" }
          },
          { "name": "verbose", "in": "query", "schema": { "type": "boolean", "default": false } }
        ],
        "responses": {
          "200": {
            "description": "Item details",
            "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Item" } } }
          },
          "404": { "description": "Item not found" }
        }
      },
      "patch": {
        "tags": ["Items"],
        "summary": "Update a local item",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "allOf": [
                  { "$ref": "#/components/schemas/Item" },
                  { "type": "object", "properties": { "note": { "type": ["string", "null"] } } }
                ]
              },
              "example": { "name": "Synthetic item" }
            }
          }
        },
        "responses": { "204": { "description": "Updated" } }
      }
    },
    "/api/v1/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Check readiness",
        "security": [],
        "responses": { "200": { "description": "Ready" } }
      }
    }
  },
  "components": {
    "securitySchemes": { "bearer": { "type": "http", "scheme": "bearer" } },
    "schemas": {
      "Item": {
        "type": "object",
        "required": ["id", "name"],
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "name": { "type": "string", "description": "A synthetic display name" },
          "state": { "type": "string", "enum": ["open", "closed"], "nullable": true },
          "children": { "type": "array", "items": { "$ref": "#/components/schemas/Item" } },
          "choice": { "anyOf": [{ "type": "string" }, { "type": "integer" }] },
          "variant": { "oneOf": [{ "type": "boolean" }, { "type": "number" }] },
          "labels": { "type": "object", "additionalProperties": { "type": "string" } }
        }
      }
    }
  }
}
