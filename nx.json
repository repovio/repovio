{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "workspaceLayout": {
    "appsDir": "apps",
    "libsDir": "libs"
  },
  "namedInputs": {
    "sharedGlobals": ["{workspaceRoot}/pnpm-lock.yaml"],
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": ["default", "!{projectRoot}/**/*.spec.ts", "!{projectRoot}/**/*.test.ts", "!{projectRoot}/test/**/*"],
    "lintConfiguration": [
      "{workspaceRoot}/eslint.config.mjs",
      "{workspaceRoot}/prettier.config.mjs",
      "{workspaceRoot}/.prettierignore",
      "{workspaceRoot}/.editorconfig",
      "{workspaceRoot}/scripts/vue-format-rules.mjs",
      "{workspaceRoot}/scripts/format.mjs",
      "{workspaceRoot}/scripts/check-documentation.mjs",
      "{workspaceRoot}/scripts/check-documentation.test.mjs",
      "{workspaceRoot}/scripts/format.test.mjs"
    ]
  },
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"],
      "outputs": ["{projectRoot}/dist"]
    },
    "docker:build": {
      "cache": true,
      "inputs": ["production", "^production"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default", "^default", "lintConfiguration"],
      "dependsOn": ["^build"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^default"],
      "dependsOn": ["^build"]
    },
    "typecheck": {
      "cache": true,
      "inputs": ["default", "^default"],
      "dependsOn": ["^build"]
    }
  },
  "analytics": false
}
